# Environment for the Hadoop/Hive/Spark systemd units (mirrors /home/hadoop/.bashrc)
# systemd does not expand $VARS here: every value is literal.
JAVA_HOME=/usr/lib/jvm/java-21-openjdk
HADOOP_HOME=/home/hadoop/hadoop
HADOOP_INSTALL=/home/hadoop/hadoop
HADOOP_MAPRED_HOME=/home/hadoop/hadoop
HADOOP_COMMON_HOME=/home/hadoop/hadoop
HADOOP_HDFS_HOME=/home/hadoop/hadoop
YARN_HOME=/home/hadoop/hadoop
HADOOP_COMMON_LIB_NATIVE_DIR=/home/hadoop/hadoop/lib/native
HADOOP_OPTS=-Djava.library.path=/home/hadoop/hadoop/lib/native
HADOOP_CONF_DIR=/home/hadoop/hadoop/etc/hadoop
SPARK_HOME=/home/hadoop/spark
PYSPARK_PYTHON=python3
HIVE_HOME=/home/hadoop/hive
TEZ_HOME=/home/hadoop/tez
TEZ_CONF_DIR=/home/hadoop/hive/conf
HADOOP_CLASSPATH=/home/hadoop/hive/conf:/home/hadoop/tez/*:/home/hadoop/tez/lib/*
KAFKA_HOME=/home/hadoop/kafka
PATH=/home/hadoop/kafka/bin:/home/hadoop/hadoop/bin:/home/hadoop/hadoop/sbin:/home/hadoop/spark/bin:/home/hadoop/hive/bin:/usr/local/bin:/usr/bin:/usr/sbin

[Unit]
Description=Hadoop HDFS (NameNode, DataNode, SecondaryNameNode)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=hadoop
Group=hadoop
EnvironmentFile=/etc/hadoop-stack.env
# PID files and hadoop.tmp.dir live in /tmp: must see the real /tmp
PrivateTmp=no
ExecStart=/home/hadoop/hadoop/bin/hdfs --daemon start namenode
ExecStart=/home/hadoop/hadoop/bin/hdfs --daemon start datanode
ExecStart=/home/hadoop/hadoop/bin/hdfs --daemon start secondarynamenode
# NameNode RPC opens seconds after the daemon forks (slower at boot): wait for it first,
# otherwise 'safemode wait' fails with Connection refused and systemd kills HDFS
ExecStartPost=/bin/bash -c 'for i in $$(seq 1 90); do (echo > /dev/tcp/localhost/9000) 2>/dev/null && exit 0; sleep 2; done; echo "NameNode RPC not reachable on 9000"; exit 1'
ExecStartPost=/home/hadoop/hadoop/bin/hdfs dfsadmin -safemode wait
ExecStop=/home/hadoop/hadoop/bin/hdfs --daemon stop secondarynamenode
ExecStop=/home/hadoop/hadoop/bin/hdfs --daemon stop datanode
ExecStop=/home/hadoop/hadoop/bin/hdfs --daemon stop namenode
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
